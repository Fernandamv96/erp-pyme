# Copia este archivo como ".env" y completa los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Clave para entrar al ERP (mínimo 12 caracteres). Usa una clave larga y única.
ADMIN_PASSWORD=

# Secreto para firmar la sesión (mínimo 32 caracteres, al azar). Para generarlo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Base de datos PostgreSQL (Neon). Si la dejas vacía, se usa PGlite:
# un Postgres que corre dentro de Node y guarda todo en data/pglite.
DATABASE_URL=

# Puerto donde corre el ERP (http://localhost:3000)
PORT=3000

# 127.0.0.1 = solo este computador.
# 0.0.0.0   = también otros equipos de la misma red (wifi de la oficina).
HOST=127.0.0.1
